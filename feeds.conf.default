# Custom feed sources for ImmortalWrt MT7986 build.
# prepare-build.sh merges this into openwrt/feeds.conf before `feeds update`.

src-git passwall_packages https://github.com/Openwrt-Passwall/openwrt-passwall-packages.git;main
src-git passwall_luci https://github.com/Openwrt-Passwall/openwrt-passwall.git;main
src-git packages https://github.com/RuijieNetworksCommunity/packages.git;openwrt-24.10
src-git luci https://github.com/RuijieNetworksCommunity/luci.git;openwrt-24.10
src-git routing https://github.com/openwrt/routing.git;openwrt-24.10
src-git telephony https://github.com/openwrt/telephony.git;openwrt-24.10
