#!/bin/sh
# First-boot defaults — runs once, then is deleted by the system.
# These are applied only if the marker is absent (preserves user changes
# across sysupgrade).

[ "$(uci -q get system.@system[0].qol_defaults)" = 1 ] && exit 0

uci -q batch << EOI
set firewall.@zone[1].input='DROP'
set system.ntp.enable_server='1'
set uhttpd.main.redirect_https='1'
EOI

# DHCP option 42: advertise this router as NTP server to LAN clients.
lan_ip=$(uci -q get network.lan.ipaddr)
[ -n "$lan_ip" ] && ! uci -q get dhcp.lan.dhcp_option | tr ' ' '\n' | grep -q '^42,' \
  && uci -q add_list dhcp.lan.dhcp_option="42,${lan_ip%%/*}"

uci -q set system.@system[0].qol_defaults='1'
uci -q commit
exit 0
